##########################################################################
# Electrostatic potential map - Mn(III) MNP complex bound to protein
##########################################################################

read
    mol pqr complex_MNP3.pqr
end

elec name mnp3
    mg-auto
    dime 161 161 161
    cglen 120 120 120
    fglen 65 70 65
    cgcent mol 1
    fgcent mol 1
    mol 1
    lpbe
    bcfl mdh
    pdie 2.0
    sdie 78.54
    srfm mol
    chgm spl2
    srad 1.4
    swin 0.3
    sdens 10.0
    temp 298.15
    ion charge 1 conc 0.150 radius 2.0
    ion charge -1 conc 0.150 radius 1.8
    calcenergy total
    calcforce no
    write pot dx pot_mnp3
end

quit
